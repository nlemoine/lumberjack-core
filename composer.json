{
    "name": "rareloop/lumberjack-core",
    "description": "A powerful MVC framework for the modern WordPress developer. Write better, more expressive and easier to maintain code",
    "license": "MIT",
    "require": {
        "php": ">=7.1.0",
        "blast/facades": "^1.0",
        "brain/hierarchy": "^3.0",
        "deliciousbrains/wp-migrations": "^2.0",
        "gajus/dindent": "dev-master",
        "google/recaptcha": "^1.2",
        "inpsyde/assets": "^2.8",
        "inpsyde/wp-context": "^1.2",
        "johnbillion/extended-cpts": "^5.0",
        "laminas/laminas-diactoros": "^2.4",
        "laminas/laminas-httphandlerrunner": "^2.1",
        "league/route": "^5.1",
        "middlewares/http-authentication": "^2.1",
        "middlewares/minifier": "^2.0",
        "middlewares/utils": "^3.3",
        "monolog/monolog": "^2.0",
        "oscarotero/middleland": "^1.0",
        "php-di/php-di": "^6.3.5",
        "piedweb/render-html-attributes": "^2.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-message": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/link": "^1.0",
        "psr/log": "^1.1",
        "rareloop/psr7-server-request-extension": "^2.1",
        "spatie/macroable": "^1.0",
        "spatie/once": "^2.2",
        "spatie/schema-org": "^3.3",
        "stoutlogic/acf-builder": "dev-master",
        "symfony/asset": "^5.3",
        "symfony/cache": "^5.3",
        "symfony/config": "^5.3",
        "symfony/console": "^5.3",
        "symfony/error-handler": "^5.3",
        "symfony/form": "^5.3",
        "symfony/http-foundation": "^5.2",
        "symfony/http-kernel": "^5.3",
        "symfony/intl": "^5.3",
        "symfony/mailer": "^5.4",
        "symfony/routing": "^5.3",
        "symfony/security-csrf": "^5.3",
        "symfony/string": "^5.3",
        "symfony/translation": "^5.3",
        "symfony/twig-bridge": "^5.3",
        "symfony/validator": "^5.3",
        "symfony/web-link": "^5.3",
        "tightenco/collect": "^8.0",
        "timber/timber": "2.x-dev",
        "twig/cache-extra": "^3.3",
        "twig/html-extra": "^3.0",
        "twig/string-extra": "^3.3",
        "ocramius/proxy-manager": "^2.13"
    },
    "require-dev": {
        "antecedent/patchwork": "^2.1.8",
        "brain/monkey": "^2.6",
        "dms/phpunit-arraysubset-asserts": "^0.4",
        "mikey179/vfsstream": "^1.6.8",
        "mockery/mockery": "^1.4.4",
        "php-coveralls/php-coveralls": "^2.0",
        "php-mock/php-mock": "^2.0",
        "phpstan/extension-installer": "^1.1",
        "phpunit/phpunit": "^9.0",
        "symplify/easy-coding-standard": "^10.0",
        "szepeviktor/phpstan-wordpress": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Rareloop\\Lumberjack\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rareloop\\Lumberjack\\Test\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/ecs check"
        ],
        "lint:fix": [
            "vendor/bin/ecs check --fix"
        ],
        "test": [
            "vendor/bin/phpunit --testdox"
        ]
    }
}
