{% block hcaptcha_widget %}
    {% if form.vars.site_key %}
        {%- set type = type|default('hidden') -%}
        {%- set is_ajax = is_ajax ?? false -%}
        {%- set placeholder_id = '%s-placeholder'|format(id) -%}
        {{ block('form_widget_simple') }}
        <div id="{{ placeholder_id }}" data-theme="{{ form.vars.theme }}" class="hcaptcha-wrapper"></div>
        {%- set validJsId = id|replace({'-':'_'}) -%}
        {%- set callbackName = 'hcaptchaCallback_%s'|format(validJsId) -%}
        <script type="text/javascript">
            (function(){
                var input = document.getElementById('{{ id }}');
                if(!input) {
                    return;
                }

                var form = input.form;
                var widgetId = null;
                var renderHcaptcha = function() {
                    widgetId = hcaptcha.render('{{ placeholder_id }}', {
                        sitekey: '{{ form.vars.site_key }}',
                        theme: Object.prototype.hasOwnProperty.call(window, 'theme') ? window.theme : 'light',
                        callback: (token) => {
                            document.getElementById('{{ id }}').value = token;
                        }
                    });
                }
                var resetHcaptcha = function() {
                    if(widgetId) {
                        hcaptcha.reset(widgetId);
                    }
                }

                window.{{ callbackName }} = renderHcaptcha;

                var loadHcaptcha = function() {
                    if(window.hcaptcha) {
                        renderHcaptcha();
                        return;
                    }
                    var script = document.createElement('script');
                    script.type = 'text/javascript';
                    script.async = true;
                    script.src = 'https://js.hcaptcha.com/1/api.js?onload={{ callbackName }}&render=explicit';
                    var firstScript = document.getElementsByTagName('script')[0];
                    firstScript.parentNode.insertBefore(script, firstScript);
                };

                {%- if is_ajax -%}
                    var reloaded = false;
                    var onFieldError = function() {
                        form.addEventListener('invalid', function() {
                            if(reloaded) {
                                return;
                            }
                            reloaded = true;
                            resetHcaptcha();
                        }, true);
                    };

                    var onFormSubmit = function() {
                        form.addEventListener('submit', function() {
                            reloaded = false;
                        });
                    };
                {%- endif -%}

                var init = function() {
                    loadHcaptcha();
                    {%- if is_ajax -%}
                        onFormSubmit();
                        onFieldError();
                    {%- endif -%}
                };

                if ('IntersectionObserver' in window &&
                    'IntersectionObserverEntry' in window &&
                    'intersectionRatio' in window.IntersectionObserverEntry.prototype) {
                    var observerCallback = function(entries, observer) {
                        entries.map(function(entry) {
                            if (entry.isIntersecting) {
                                init();
                                observer.unobserve(form);
                            }
                        });
                    }
                    var observer = new IntersectionObserver(observerCallback);
                    observer.observe(form);
                } else {
                    init();
                }
            })();
        </script>



    {% endif %}
{% endblock %}
