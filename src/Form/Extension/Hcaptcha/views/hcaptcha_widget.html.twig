{% block hcaptcha_widget %}
    {% if form.vars.site_key %}
        {%- set type = type|default('hidden') -%}
        {{ block('form_widget_simple') }}
        <div id="{{ id }}-view" data-theme="{{ form.vars.theme }}" class="hcaptcha-wrapper"></div>
        {%- set validJsId = id|replace({'-':'_'}) -%}
        {%- set callbackName = 'recaptchaCallback_%s'|format(validJsId) -%}
        <script {% if form.vars.script_nonce_csp is defined %}nonce="{{ form.vars.script_nonce_csp }}"{% endif %}>
            var {{ callbackName }} = function() {
                hcaptcha.render("{{ id }}-view", {
                    sitekey: '{{ form.vars.site_key }}',
                    callback: (token) => {
                        document.getElementById('{{ id }}').value = token;
                    }
                });
            }
        </script>
        <script src='https://js.hcaptcha.com/1/api.js?onload={{ callbackName }}&render=explicit' async defer></script>
    {% endif %}
{% endblock %}
